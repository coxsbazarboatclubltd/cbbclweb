{
  "redirects": [
    {
      "source": "/:path((?!sw\\.js$).*)",
      "has": [
        {
          "type": "host",
          "value": "cbbcl.org"
        }
      ],
      "destination": "https://www.cbbcl.org/:path",
      "permanent": true
    },
    {
      "source": "/:section(board|profile)/md-atiqul-islam",
      "destination": "/:section/atiqul-islam",
      "permanent": true
    },
    {
      "source": "/:path*.html",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
